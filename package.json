{
  "name": "2c2p-payments",
  "displayName": "2C2P Payments",
  "description": "2C2P Payment Gateway integration assistant — Chat AI + Documentation Browser",
  "version": "0.1.0",
  "publisher": "2c2p",
  "icon": "assets/logo-square.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Chat",
    "Snippets",
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "2c2p-payments.2c2p",
        "fullName": "2C2P Payments",
        "name": "2c2p",
        "description": "Ask me about 2C2P payment integration",
        "isSticky": true,
        "commands": [
          {
            "name": "quickpay",
            "description": "Guide QuickPay link integration"
          },
          {
            "name": "redirect",
            "description": "Guide Hosted Payment Page integration"
          },
          {
            "name": "direct",
            "description": "Guide Direct API integration"
          },
          {
            "name": "test",
            "description": "Show sandbox test cards"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "2c2p-payments-view",
          "title": "2C2P Payments",
          "icon": "assets/icon-activity.svg"
        }
      ]
    },
    "views": {
      "2c2p-payments-view": [
        {
          "id": "2c2p-methods",
          "name": "Integration Methods"
        }
      ]
    },
    "commands": [
      {
        "command": "2c2p.setupSandboxCredentials",
        "title": "2C2P: Setup Sandbox Credentials"
      },
      {
        "command": "2c2p.openDoc",
        "title": "2C2P: Open Documentation"
      }
    ],
    "snippets": [
      { "language": "javascript", "path": "./snippets/javascript.json" },
      { "language": "typescript", "path": "./snippets/javascript.json" },
      { "language": "python", "path": "./snippets/python.json" },
      { "language": "java", "path": "./snippets/java.json" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/node": "20.x",
    "typescript": "^5.5.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.9.1"
  }
}
